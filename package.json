{
  "name": "discord-mesai-bot",
  "version": "2.0.0",
  "description": "Discord Mesai & Vardiya Yönetim Botu (FiveM & Roleplay Toplulukları İçin) - Discord.js v14 Tabanlı Profesyonel Yönetim Sistemi",
  "main": "bot.js",
  "type": "module",
  "author": {
    "name": "Luzzysxdd",
    "url": "https://github.com/Luzzysxdd"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Luzzysxdd/discord-mesai-bot.git"
  },
  "homepage": "https://github.com/Luzzysxdd/discord-mesai-bot#readme",
  "license": "Custom-Attribution-NonCommercial",
  "private": false,
  "scripts": {
